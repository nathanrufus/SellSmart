import from src.services.models { Plan, NetQuote, HoldDecision, RainRisk, TrendResult }
import from src.services.config { load_strings }
import from src.services.util { round2 }

# Advisor agent. Writes the farmer-facing answer from approved findings only.
# Numbers and market names are inserted by code from the approved quote, never
# generated by a model, so they cannot be mistranslated or invented.

def _s(strings: dict[str, str], key: str) -> str {
    return strings.get(key, key);
}

def _f(x: float) -> str {
    return f"{x:,.0f}";
}

def _f1(x: float) -> str {
    return f"{x:,.1f}";
}

def level_label(strings: dict[str, str], level: str) -> str {
    return _s(strings, "level_" + level);
}

def compose_answer(
    plan: Plan, top: NetQuote | None, nearest: NetQuote | None, hold: HoldDecision | None,
    rain: RainRisk | None, trend: TrendResult | None, confidence: str, excluded_markets: int,
    window_days: int, bag_kg: float
) -> dict[str, any] {
    strings = load_strings(plan.language);
    lines: list[str] = [];
    if top is None {
        text = _s(strings, "no_answer").format(product=plan.product);
        return {"language": plan.language, "headline": text, "lines": [text], "text": text};
    }
    headline = _s(strings, "headline").format(
        product=plan.product, market=top.market, county=top.county,
        net_kg=_f1(top.net_per_kg), net_bag=_f(top.net_per_bag), bag_kg=_f(bag_kg)
    );
    lines.append(headline);
    lines.append(_s(strings, "total").format(qty=f"{plan.quantity_bags:g}", total=_f(top.total_net)));
    if nearest is not None and top.transport_known {
        if nearest.market == top.market {
            lines.append(_s(strings, "is_nearest").format(market=top.market));
        } else {
            gain = (top.net_per_kg - nearest.net_per_kg) * bag_kg;
            if gain > 0.0 {
                lines.append(_s(strings, "vs_nearest").format(gain=_f(gain), nearest=nearest.market));
            }
        }
    }
    if hold is not None and plan.wants_hold {
        if hold.action == "hold" and trend is not None {
            lines.append(_s(strings, "hold_rising").format(pct=_f1(trend.pct_per_week)));
        } elif "rain_high" in hold.reasons {
            lines.append(_s(strings, "sell_now_rain"));
        } else {
            lines.append(_s(strings, "sell_now"));
        }
    }
    if rain is not None and rain.level == "high" {
        lines.append(_s(strings, "rain_warning").format(county=rain.county));
    }
    lines.append(_s(strings, "data_note").format(date=top.latest_day, n=str(top.n_reports), days=str(window_days)));
    if excluded_markets > 0 {
        lines.append(_s(strings, "excluded_note").format(n=str(excluded_markets)));
    }
    lines.append(_s(strings, "confidence").format(level=level_label(strings, confidence)));
    lines.append(_s(strings, "disclaimer"));
    return {"language": plan.language, "headline": headline, "lines": lines, "text": " ".join(lines)};
}

def needs_product_answer(plan: Plan, options: list[str]) -> dict[str, any] {
    strings = load_strings(plan.language);
    text = _s(strings, "needs_product").format(options=", ".join(options));
    return {"language": plan.language, "headline": text, "lines": [text], "text": text};
}

def info_answer(plan: Plan, key: str, fields: dict[str, str]) -> dict[str, any] {
    strings = load_strings(plan.language);
    text = _s(strings, key).format(**fields);
    return {"language": plan.language, "headline": text, "lines": [text], "text": text};
}

def confidence_level(
    n_quotes: int, n_points: int, flags: list[str], replans: int, transport_known: bool, rain_known: bool
) -> str {
    score = 0;
    if n_quotes >= 3 {
        score += 2;
    } elif n_quotes == 2 {
        score += 1;
    }
    if n_points >= 8 {
        score += 1;
    }
    if len(flags) == 0 {
        score += 1;
    }
    if replans == 0 {
        score += 1;
    }
    if transport_known {
        score += 1;
    }
    if rain_known {
        score += 0;
    }
    if score >= 5 {
        return "high";
    }
    if score >= 3 {
        return "medium";
    }
    return "low";
}

def money(x: float) -> float {
    return round2(x);
}
